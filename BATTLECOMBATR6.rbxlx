            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{DC06B618-32A0-42C7-865C-481FAAF263C2}</string>
            <string name="Source"><![CDATA[local TS = game:GetService("TweenService")
local char = script.Parent.Parent.Parent.Parent

local hum = char.Humanoid
local model = hum.Parent:Clone()
local cframe = model:GetPivot()

local duration = 0.7 

local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)

local indicator = char.StunIndicator
-- Start the tween
local currhealth = nil
local text = script.Parent
local rotation,size = text.Rotation,text.Size
text.Text = math.floor((hum.Health/hum.MaxHealth)*100).."%"
local function onDamage(health)
	text.TextColor3 = Color3.fromRGB(255,0,0)
	indicator.Color = BrickColor.new("Really red").Color
	
	text.Rotation = math.random(-20,20)
	text.Size = UDim2.new(1,0,1,0)
	TS:Create(text,TweenInfo.new(.25,Enum.EasingStyle.Sine),{Rotation = rotation,Size = size}):Play()

	task.delay(1,function()
		if hum.Health >= health then
			script.Parent.TextColor3 = Color3.fromRGB(255,255,255)
			indicator.Color = BrickColor.new("Lime green").Color
		end
	end)
	text.Text = tostring(math.floor((health/hum.MaxHealth) * 100)).."%"

	currhealth = math.floor((health/hum.MaxHealth) * 100)
end
hum.HealthChanged:Connect(onDamage)

local blocking = char:GetAttribute("Blocking")
if not blocking then
	local idleAnimation = Instance.new("Animation")
	idleAnimation.AnimationId = "rbxassetid://93813843414726" --CHANGE IDLE ANIMATION ID HERE!!!!!
	hum.Animator:LoadAnimation(idleAnimation):Play()
end
hum.Died:Connect(function()
	model:PivotTo(cframe)
	model.Parent = workspace.Dummies
	
	task.wait(1)
	hum.Parent:Destroy()
end) ]]></string>
            <int64 name="SourceAssetId">-1</int64>
