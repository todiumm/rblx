            <string name="ScriptGuid">{4FA21F9A-47E1-4B21-8D3A-85D1951C3E75}</string>
            <string name="Source"><![CDATA[local userInputService = game:GetService("UserInputService")
local TS = game.TweenService

local cameraModule = require(script:WaitForChild("Camera"))
local cameraMode = "Freecam"

local main = script.Parent
local targetFrame = main.Target

local gui = script.Parent

local RP = game.ReplicatedStorage
local Utility = require(RP.Modules.Utility)

local textLabel = script.Parent.Text
local Debounce,Range = false,50

local Player = game.Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
gui.MouseButton1Down:Connect(function()
	if Debounce then return end
	local Magnitude,enemiesNearby = (Character.HumanoidRootPart.Position - Character.HumanoidRootPart.Position).Magnitude,false
	for _,v in (workspace:GetDescendants()) do
		local Enemy = v.Parent
		local EHum = Enemy:FindFirstChildOfClass("Humanoid")
		if EHum then
			enemiesNearby = true
		end
	end
	if not enemiesNearby then return end
	if cameraMode == "Freecam" then
		cameraMode = "LockNearest"
		cameraModule.LockNearest(targetFrame)
		
		
		--script.offLock:FireServer()
	else
		
		cameraMode = "Freecam"
		cameraModule.Freecam(targetFrame)
	end
	Debounce = true; task.delay(.45,function()
		Debounce = false
	end)
end)
]]></string>
            <int64 name="SourceAssetId">-1</int64>
