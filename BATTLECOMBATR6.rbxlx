        <string name="Source"><![CDATA[-- SERVICES --
local CS = game:GetService("CollectionService")
local SSS = game:GetService("ServerScriptService")

-- TAG --
local Tag = "NPC"

-- MODULE --
local RagdollModule = require(script.RagdollBuilder)

-- FUNCTIONS --
for i, v in pairs(CS:GetTagged(Tag)) do
	if v:IsA("Model") then
		RagdollModule:Setup(v)
		print(v)
	end
end

-- EXTRA --
CS:GetInstanceAddedSignal(Tag):Connect(function(v)
	if v:IsA("Model") and v:IsDescendantOf(workspace) then
		RagdollModule:Setup(v)
		print(v)
	end
end)
]]></string>
