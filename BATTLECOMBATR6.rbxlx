          <string name="ScriptGuid">{AD5B849D-FDA8-48EA-8E75-5DCB810370D0}</string>
          <string name="Source"><![CDATA[local module = {}
local CollectionService = game.CollectionService
local TS,Debris = game.TweenService,game.Debris
local RockModule,Utility = require(game.ReplicatedStorage.Modules.RockModule),require(game.ReplicatedStorage.Modules.Utility)
local Camera = workspace.CurrentCamera
local cameraShaker = require(game.ReplicatedStorage.Modules.CameraShaker)

function module.Dash(Data) 
	local Character = Data.Char
	local Direction = Data.Dir
	local animSubstance = Data.Anim
	local RootPart = Character.HumanoidRootPart

	local Canceled
	if Direction == "Backward" then
		animSubstance:AdjustSpeed(1.2)
	elseif Direction == "Front" then


		local Presets = Utility.CreateHitbox({Character = Character,Transparency = 1,cFrame = RootPart.CFrame * CFrame.new(0,0,(1 + ((Vector3.new(5.899, 6, 6.051).Z)/2) * -1))})
		local Detect,Blacklist = Presets.Hitbox,{}; Debris:AddItem(Detect,.7)
		local Params = Presets.Params
		local Weld,Connection = Instance.new("WeldConstraint"); Weld.Part0 = Detect; Weld.Part1 = RootPart; Weld.Parent = Detect

		Params.FilterType = Enum.RaycastFilterType.Exclude
		Params.FilterDescendantsInstances = {workspace.Map,Character}

		Connection = game["Run Service"].Heartbeat:Connect(function()
			if not Detect.Parent then Connection:Disconnect() end

			local partsFound = workspace:GetPartsInPart(Detect,Params)

			if #partsFound > 0 then
				for _,v in pairs(partsFound) do

					local Enemy = v.Parent
					if not Enemy then return end
					local EHum = Enemy:FindFirstChildWhichIsA("Humanoid")

					if EHum and EHum:GetState() ~= Enum.HumanoidStateType.Dead and #Blacklist == 0 and Enemy:GetAttribute('Ragdolled') then

						table.insert(Blacklist,Enemy)

						local EnemyRP = Enemy.HumanoidRootPart

						local rayParams = RaycastParams.new(); rayParams.FilterType = Enum.RaycastFilterType.Include
						rayParams.FilterDescendantsInstances = {workspace.Map}
						local ray = workspace:Raycast(RootPart.CFrame.Position,RootPart.CFrame.LookVector*10,rayParams)
						if ray then
							local Inst = ray.Instance
							if Inst then 
								Canceled = true print(Canceled)
								Detect:Destroy()
								Connection:Disconnect()
								animSubstance:Stop()

								game.ReplicatedStorage.Remotes.Combat:FireServer("WallCombo",ray.Position,Enemy)

								local camShake = cameraShaker.new(Enum.RenderPriority.Camera.Value, function(shakeCFrame)
									Camera.CFrame *= shakeCFrame
								end)
								camShake:Start()
								camShake:Shake(cameraShaker.Presets.Explosion)


								task.defer(function()


									for i = 1,4 do task.wait(.5)

										local blur = Instance.new("BlurEffect"); Debris:AddItem(blur,.5)
										blur.Size = 14
										TS:Create(blur,TweenInfo.new(.5),{Size = 0}):Play()
										blur.Parent = game.Lighting

										local h = Instance.new('Highlight'); Debris:AddItem(h ,.5)
										h.FillColor = Color3.fromRGB(255, 255, 255)
										h.OutlineColor = Color3.fromRGB(0,0,0)
										h.FillTransparency = 0
										h.OutlineTransparency = 1
										TS:Create(h, TweenInfo.new(.5), {FillTransparency = 1;}):Play()
										h.Parent = Character


									end
									local ColorCorrection = Instance.new('ColorCorrectionEffect')
									ColorCorrection.Saturation = -1
									ColorCorrection.Contrast = -3
									ColorCorrection.Parent = game:GetService('Lighting')

									task.delay(0.04, function()
										ColorCorrection.Saturation = -1
										ColorCorrection.Contrast = 3

										task.wait(0.02)
										ColorCorrection:Destroy()
									end)

								end)

								TS:Create(workspace.CurrentCamera,TweenInfo.new(.2,Enum.EasingStyle.Exponential),{FieldOfView = 80}):Play()
								task.wait(.22)
								TS:Create(workspace.CurrentCamera,TweenInfo.new(1,Enum.EasingStyle.Exponential),{FieldOfView = 50}):Play()
								task.wait(1.78)
								TS:Create(workspace.CurrentCamera,TweenInfo.new(.5,Enum.EasingStyle.Quad),{FieldOfView = 70}):Play()
								Character.Humanoid.CameraOffset = Vector3.new(0,-3,0)
								TS:Create(Character.Humanoid,TweenInfo.new(.5,Enum.EasingStyle.Quad),{CameraOffset = Vector3.new()}):Play()


							end
						end


					end
				end

			end
		end)

	end
	
	local DashVelocity = Instance.new("BodyVelocity")
	DashVelocity.MaxForce = Vector3.new(30000,0,30000)
	DashVelocity.Parent = RootPart

	local Health = Character.Humanoid.Health
	local Velocity
	local Connection
	local cancelWindow = os.clock()

	task.defer(function()
		local Clock,Duration = os.clock(),.5

		local h = Instance.new('Highlight')
		h.FillColor = Color3.fromRGB(255, 255, 255)
		h.OutlineColor = Color3.fromRGB(0,0,0)
		h.FillTransparency = 0
		h.OutlineTransparency = 0
		h.Parent = Character
		game.TweenService:Create(h, TweenInfo.new(.75), {
			FillTransparency = 1;
			OutlineTransparency = 1
		}):Play()
		game.Debris:AddItem(h ,.75)


		repeat task.wait(.075) if Canceled then break end
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = {workspace.Map}


			local smokePart = game.ReplicatedStorage.Assets.Effects.Combat.SmokePart:Clone()
			smokePart.Parent = workspace.Debris
			smokePart.CFrame = RootPart.CFrame * CFrame.new(0,-1.5,0)

			local raycast = workspace:Raycast(smokePart.Position, Vector3.new(0, -2.5, 0) , params)
			if raycast then
				smokePart.Position = raycast.Position

				for _, particle in pairs(smokePart:GetDescendants()) do
					if particle:IsA("ParticleEmitter") then
						particle.Color = ColorSequence.new(raycast.Instance.Color)
						particle:Emit()
					end
				end
				game.Debris:AddItem(smokePart,2)
			else
				smokePart:Destroy()
			end


			RockModule.SideRock2(RootPart.CFrame,RootPart.CFrame.UpVector*-5,2,.75,1.5)

		until (os.clock() - Clock) > Duration or Character.Humanoid.Health < Health
	end)

	animSubstance.Stopped:Connect(function()
		Character.Humanoid.AutoRotate = true
	end)

	Connection = Character.Humanoid.HealthChanged:Connect(function(HP)
		if Health > HP and (os.clock() - cancelWindow < .4375) then --if the health they had at the start of the dash is more than their current hp
			Canceled = true
			Velocity = 0
			animSubstance:Stop()
			Debris:AddItem(DashVelocity,0)
			Connection:Disconnect()
		end
	end)
	animSubstance:GetMarkerReachedSignal("Freeze"):Connect(function()
		animSubstance:AdjustSpeed(0)
		task.wait(.3)
		animSubstance:AdjustSpeed(1)
	end)
	task.delay(.7669730000197887,function() 
		if Direction == "Front" then
			
			DashVelocity:Destroy()
			Connection:Disconnect()
			if Canceled then return end

			game.ReplicatedStorage.Remotes.Combat:FireServer("FrontDash")
		end

	end)
	if Canceled then return end
	if Direction == "Front" then
		
		local Ring = game.ReplicatedStorage.Assets.Effects.Combat.DashShockwave:Clone() Debris:AddItem(Ring,.3)
		Ring.CFrame = RootPart.CFrame*CFrame.new(0,0,1); Ring.CFrame*=CFrame.Angles(math.rad(90),math.rad(0),math.rad(0)); Ring.Parent = workspace.Debris

		Utility.LimbTrail(Character["Right Arm"],.6)

		TS:Create(Ring,TweenInfo.new(.25,Enum.EasingStyle.Quad),{Size = Vector3.new(8,.75,8);Transparency = 1;CFrame = Ring.CFrame*CFrame.new(0,0,-1)}):Play()


		Velocity = 120
		DashVelocity.Velocity = RootPart.CFrame.LookVector * Velocity
		repeat if Canceled then
				Velocity = 0 break
			end
			if Velocity < 7 then
				Velocity -= 1
			else
				Velocity -= 7
			end
			task.wait(.025)

			DashVelocity.Velocity = RootPart.CFrame.LookVector * Velocity
		until Velocity == 0 or Character.Humanoid.Health < Health

	elseif Direction == "Backward" then

		Utility.LimbTrail(Character["Right Arm"],.5) Utility.LimbTrail(Character["Left Arm"],.5)

		Velocity = 100

		DashVelocity.Velocity = RootPart.CFrame.LookVector * -Velocity

		animSubstance:GetMarkerReachedSignal("dashAgain"):Connect(function()
			Velocity = 80
		end)
		repeat if Canceled then
				Velocity = 0 break
			end
			task.wait(.025)
			Velocity -= 7.5

			DashVelocity.Velocity = RootPart.CFrame.LookVector * -Velocity
		until Velocity < 0 or Character.Humanoid.Health < Health


	end
	
	if Direction ~= "Front" then
		DashVelocity:Destroy()
		if Velocity > 0 then
			animSubstance:Stop()
		end

	end
	
end

function module.sideDash(Data)
	local Character = Data.Char
	local animSubstance = Data.Anim
	local Direction = Data.Dir
	local RootPart = Character.HumanoidRootPart

	local DashVelocity = Instance.new("BodyVelocity")
	DashVelocity.MaxForce = Vector3.new(30000,0,30000)
	DashVelocity.Parent = RootPart

	local Health = Character.Humanoid.Health
	local Velocity
	local Connection
	local Canceled
	local cancelWindow = os.clock()
	Utility.LimbTrail(Character["Right Arm"],.5) Utility.LimbTrail(Character["Left Arm"],.5)
	task.defer(function()
		local Clock,Duration = os.clock(),.3

		local h = Instance.new('Highlight')
		h.FillColor = Color3.fromRGB(255, 255, 255)
		h.OutlineColor = Color3.fromRGB(0,0,0)
		h.FillTransparency = 0
		h.OutlineTransparency = 0
		h.Parent = Character
		game.TweenService:Create(h, TweenInfo.new(.75), {
			FillTransparency = 1;
			OutlineTransparency = 1
		}):Play()
		game.Debris:AddItem(h ,.75)


		repeat task.wait(.075)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = {workspace.Map}


			local smokePart = game.ReplicatedStorage.Assets.Effects.Combat.SmokePart:Clone()
			smokePart.Parent = workspace.Debris
			smokePart.CFrame = RootPart.CFrame * CFrame.new(0,-1.5,0)

			local raycast = workspace:Raycast(smokePart.Position, Vector3.new(0, -2.5, 0) , params)
			if raycast then
				smokePart.Position = raycast.Position

				for _, particle in pairs(smokePart:GetDescendants()) do
					if particle:IsA("ParticleEmitter") then
						particle.Color = ColorSequence.new(raycast.Instance.Color)
						particle:Emit()
					end
				end
				game.Debris:AddItem(smokePart,2)
			else
				smokePart:Destroy()
			end


			RockModule.SideRock2(RootPart.CFrame,RootPart.CFrame.UpVector*-5,2,.75,1.5)

		until (os.clock() - Clock) > Duration or Character.Humanoid.Health < Health
	end)

	animSubstance.Stopped:Connect(function()
		Character.Humanoid.AutoRotate = true
	end)

	Connection = Character.Humanoid.HealthChanged:Connect(function(HP)
		if Health > HP and (os.clock() - cancelWindow < .4375) then --if the health they had at the start of the dash is more than their current hp
			Canceled = true
			Velocity = 0
			animSubstance:Stop()
			Debris:AddItem(DashVelocity,0)
			Connection:Disconnect()
		end
	end)


	Velocity = 100

	if Direction == "Left" then
		DashVelocity.Velocity = RootPart.CFrame.RightVector * -Velocity

		repeat
			task.wait(.025)
			Velocity -= 7.5

			DashVelocity.Velocity = RootPart.CFrame.RightVector * -Velocity
		until Velocity < 0 or Character.Humanoid.Health < Health

	elseif Direction == "Right" then
		DashVelocity.Velocity = RootPart.CFrame.RightVector * Velocity

		repeat
			task.wait(.025)
			Velocity -= 7.5

			DashVelocity.Velocity = RootPart.CFrame.RightVector * Velocity
		until Velocity < 0 or Character.Humanoid.Health < Health

	end

	DashVelocity:Destroy()
	if Velocity > 0 then
		animSubstance:Stop()
	end

end
return module
]]></string>
