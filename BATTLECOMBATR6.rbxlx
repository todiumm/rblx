          <string name="ScriptGuid">{F0A6EF40-0370-4DC9-AEB4-84D4E430BA61}</string>
          <string name="Source">-- script is to stay disabled so that it accurately identifies the player as the char
local char = script.Parent
local hum = char:WaitForChild("Humanoid")
local RGed = char:WaitForChild("RGed")



local function change_state()
	if RGed.Value then
		hum:ChangeState(Enum.HumanoidStateType.Physics)
	else
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end



RGed.Changed:Connect(change_state)</string>
