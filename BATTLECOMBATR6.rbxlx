        <Item class="LocalScript" referent="4279">
          <Properties>
            <string name="Name">WallCutscene</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">false</bool>
            <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <string name="ScriptGuid">{E5707EB6-85DB-4F88-81DC-A1E8C21897E7}</string>
            <string name="Source"><![CDATA[local UIS = game:GetService('UserInputService')
local StarterPlayer = game.StarterPlayer
local RunService = game:GetService("RunService")
local TS = game:GetService("TweenService")

local Camera = workspace.Camera
local Player = game.Players.LocalPlayer


local Debounce = false

local RES = game.ReplicatedStorage
local Remote = RES.Remotes.WallCutscene

local Player = game.Players.LocalPlayer


local function lerp(a,b,t)
	return a + (b-a) * t
end
local function curve(p1,midd,p2,t)
	local l1 = lerp(p1,midd,t)
	local l2 = lerp(midd,p2,t)
	local quad = lerp(l1,l2,t)
	return quad
end

function Cinematic()
	local CinematicsFolder = script.Anim

 	local CurrentCameraCFrame = workspace.CurrentCamera.CFrame
	local FrameTime = 0  
	local Connection

	Camera.CameraType = Enum.CameraType.Scriptable Player.Character.Humanoid.AutoRotate = false
	
	Connection = RunService.RenderStepped:Connect(function(DT)
		FrameTime += DT*60
		local NeededFrame = CinematicsFolder.Frames:FindFirstChild(tonumber(math.ceil(FrameTime)))

		if NeededFrame then
			Camera.CFrame = Player.Character.HumanoidRootPart.CFrame * NeededFrame.Value
		else 
			Connection:Disconnect()
			Camera.CameraType = Enum.CameraType.Custom
			Camera.CFrame = CurrentCameraCFrame	
		end
	end)
	
	local UI = Player.PlayerGui.Onomatopoeia.Frame
	
	local Image = UI.ImageLabel 
	local Text1,Text2 = UI.TextLabel,UI.TextLabel2
	UI.Parent.Enabled = true
	
	task.delay(2,function() Image.Parent = UI UI.Parent.Enabled = false end)
	
	local imagePosition,imageSize = UDim2.new(-.007,0,.001,0),UDim2.new(0,167,0,173)
	local text1Pos,text2Pos = UDim2.new(-.76,0,.774,0),UDim2.new(-.371,0,.907,0)

	Image.Size = UDim2.new(0,250,0,250)
	Image.Position = UDim2.new(-.007,0,-1.692,0)
	TS:Create(Image, TweenInfo.new(.6 ,Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),{Position = imagePosition;Size = imageSize}):Play()
	
	Text1.Position = UDim2.new(-1.5,0,.774,0) Text2.Position = UDim2.new(1.25,0,.907,0)
	TS:Create(Text1, TweenInfo.new(.6 ,Enum.EasingStyle.Back, Enum.EasingDirection.Out),{Position = text1Pos}):Play()
	TS:Create(Text2, TweenInfo.new(.6 ,Enum.EasingStyle.Back, Enum.EasingDirection.Out),{Position = text2Pos}):Play()
	
	
	--[[task.wait(.22)


	local pc = require(game.ReplicatedStorage.PartCache)
	Player.Character.Archivable = true 
	local clone = Player.Character:Clone()
	
	local cache = pc.new(clone["Left Arm"],50,workspace.Debris)
	for _ = 1,50 do
		local arm = cache:GetPart()
		arm.Parent = workspace.Debris

		local midpos = Player.Character.HumanoidRootPart.CFrame:Lerp(Player.Character.HumanoidRootPart.CFrame*CFrame.new(0,0,-5), 0.5).Position + CFrame.new(0,math.random(-3,5),math.random(-10,10)).Position
		task.spawn(function()
			for i = 0,50,1 do
				local t = i/20
				print(t)

				local ler = curve(workspace["yurrr listen man"].HumanoidRootPart.Position,midpos,Player.Character.HumanoidRootPart.LookVector*4,t)
				local ler2 = curve(workspace["yurrr listen man"].HumanoidRootPart.Position,midpos,Player.Character.HumanoidRootPart.LookVector*4,t+0.1)


				arm.CFrame =  CFrame.new(ler, ler2)*CFrame.Angles(math.pi/2,0,0)


				task.wait()

			end

			arm.Trail.Enabled = false
			cache:ReturnPart(arm)
			task.wait(0.1)
			task.wait(0.06)
			arm.Trail.Enabled = true
		end)
		task.wait(0.01)

	end]]
	
end

Remote.OnClientEvent:Connect(Cinematic)
]]></string>
