        <string name="ScriptGuid">{55E8CE19-2BB9-4A64-922A-CA1D34493794}</string>
        <string name="Source"><![CDATA[local RGhandler = require(script.Parent:FindFirstChild("ragdollM"))
local npcfolder = workspace.Dummies
local RagdollModule = require(game.ServerScriptService:WaitForChild("ragdollM"))

game.Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function(char)
		RagdollModule.setup(char)
		
		local LS = script:WaitForChild("PRDoll"):Clone()
		LS.Parent = char
		LS.Enabled = true
		local ragdolled = Instance.new("BoolValue", char)
		ragdolled.Name = "RGed"
		for i, v in pairs(npcfolder:GetDescendants()) do
			if v.ClassName == "Humanoid" then
				local char = v.Parent
				local RS = script:FindFirstChild("NPCRDoll"):Clone() 
				RS.Parent = char
				RS.Enabled = true
				local ragdolled = Instance.new("BoolValue", char)
				ragdolled.Name = "RGed"
			end
		end
	end)
end)

RGhandler.RDoll(char) -- triggers ragdoll
RGhandler.DRDoll(char) -- disables ragdoll
-- in the npc and player ragdoll distributed scripts you will find that these value changes are attributed to them, i'd suggest making your own to fit the combat system
-- using events and victim checks you can additionally add knockback to the basic module i've given you
-- sadly i could only get it down to 4 script, 5 if you include the one you will have to make for your combat system but it does its job well
-- compared to the other module you had which was 293 lines in its entirety id say this is a step up in efficiency being only 100 excluding these notes
]]></string>
