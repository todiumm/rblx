        <string name="ScriptGuid">{861632DD-1CFB-473E-B64A-A7B649430225}</string>
        <string name="Source">local module = {}
function module.setup(char)
	for i, joint in pairs(char:GetDescendants()) do
		if joint:IsA("Motor6D") then
			local socketjoint = Instance.new("BallSocketConstraint", joint.Parent)
			local att0 = Instance.new("Attachment", joint.Part0)
			local att1 = Instance.new("Attachment", joint.Part1)

			att0.CFrame = joint.C0
			att1.CFrame = joint.C1

			socketjoint.Attachment0 = att0
			socketjoint.Attachment1 = att1
			socketjoint.TwistLimitsEnabled = true
			socketjoint.LimitsEnabled = true
		end
	end
end

function module.RDoll(char)

	if char:WaitForChild("RGed").Value then return end

	char.RGed.Value = true


	char:SetAttribute("Ragdolled",true)
	for i, joint in pairs(char:GetDescendants()) do
		if joint:IsA("Motor6D") then
			joint.Enabled = false
		end
	end
end

function module.DRDoll(char)
	char.RGed.Value = false
	char:SetAttribute("Ragdolled",false)

	for i, joint in pairs(char:GetDescendants()) do
		if joint:IsA("Motor6D") then
			joint.Enabled = true
		elseif joint:IsA("BallSocketConstraint") then
			joint.Enabled = false
		end
	end

end

return module</string>
