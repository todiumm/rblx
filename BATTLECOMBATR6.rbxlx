          <string name="Source"><![CDATA[local module = {}

function module:Weld(Part0 : Part, Part1 : Part)
	if (Part0 and Part0.Parent) and (Part1 and Part1.Parent) then
		local weldConstraint = Instance.new("WeldConstraint")
		weldConstraint.Name = "Weld_"..Part0.Name.."_"..Part1.Name
		weldConstraint.Parent = Part0
		weldConstraint.Part0 = Part0
		weldConstraint.Part1 = Part1
		
		return weldConstraint
	end
end

return module
]]></string>
