          <string name="ScriptGuid">{30DD6D79-770C-4B4E-BF89-234A14FEFCFE}</string>
          <string name="Source"><![CDATA[local Utility = {}
local RES = game.ReplicatedStorage
local Assets = RES.Assets
local SFX = Assets.SFX
local RP = game:GetService("ReplicatedStorage")
local TweenService = game:GetService('TweenService') 
local Debris = game:GetService("Debris")
local RS = game:GetService("RunService")

function Utility.Knockback(Parent,Velocity,Lifetime)
	if not Lifetime then
		Lifetime = .2 
	end
	local Attachment = Instance.new('Attachment') Debris:AddItem(Attachment,Lifetime) 
	Attachment.Parent = Parent 
	local BV = Instance.new('LinearVelocity',Attachment)

	BV.Attachment0 = Attachment
	BV.MaxForce = 30000
	BV.VectorVelocity = Velocity
end

function Utility.LimbTrail(Parent,Lifetime,Dash)
	local Trail = Assets.Effects.Combat.LimbTrail:Clone() Debris:AddItem(Trail,Lifetime)
	if Dash then
		for _,v in Trail:GetDescendants() do
			if v:IsA('Trail') then
				v.LightInfluence = 0
				v.Brightness = 10
			end
		end
	end
	local Weld = Instance.new("WeldConstraint")

	Trail.CFrame = Parent.CFrame; 
	Weld.Part0 = Parent; Weld.Part1 = Trail
	Weld.Parent = Trail
	Trail.Parent = workspace.Debris
end
function Utility.JustDamageIn(Data)
	local Vroot = Data.Vroot 
	local Dmg = Data.Dmg

	--dmg indicator 	
	task.defer(function()
		local DamageAmount = "-"..Dmg
		local x = math.random(-4,4)
		--local DMM = string.sub( tostring(DamageAmount),1,4 )

		local DamageIndicator = script.Assets.Damage:Clone()
		DamageIndicator.CFrame = Vroot.CFrame*CFrame.new(x,0,0)
		DamageIndicator.Bill.T1.Text = "-"..tostring(Dmg)
		DamageIndicator.Anchored = false
		DamageIndicator.Bill.T1:FindFirstChild("Text").Text = "-"..tostring(Dmg)
		DamageIndicator.Parent = workspace.Debris

		--module.Clasic_tween(DamageIndicator.Bill.T1:FindFirstChild('Text'), {Tim = .16*2, EasingStyle = Enum.EasingStyle.Quad, EasingDirection = Enum.EasingDirection.Out,redo = true, Textcolr = BrickColor.new('Really red'), startTextcolr = BrickColor.random().Color })
		DamageIndicator.Bill.T1.TextColor3 = BrickColor.new('Really black').Color
		local Tween = TweenService:Create(DamageIndicator.Bill.T1:FindFirstChild("Text"),TweenInfo.new(.16,Enum.EasingStyle.Quad,Enum.EasingDirection.Out,0,true,0),{TextColor3 = Color3.fromRGB(216, 31, 31) })
		Tween:Play()
		Tween:Destroy()
		Debris:AddItem(DamageIndicator,.5)

		local BodyVelocity = Instance.new("BodyVelocity")
		BodyVelocity.P = 30000
		BodyVelocity.MaxForce = Vector3.new(0,4e4,0)
		BodyVelocity.Velocity = Vector3.new(0,15,0)
		BodyVelocity.Parent = DamageIndicator
		Debris:AddItem(BodyVelocity,.08)
	end)



end

function Utility.SoundEffect(SoundEffect,Parent,Combat)
	local Sound = SoundEffect:Clone()
	Sound.Parent = Parent
	Debris:AddItem(Sound,SoundEffect.TimeLength)
	Sound:Play()
	return Sound
end
function Utility.HitSound(Parent,Blocking)
	if Blocking then
		local RNG = math.random(1,4)
		if RNG == 1 then
			local Sound = SFX.Combat.BlockHit1:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		elseif RNG == 2  then
			local Sound = SFX.Combat.BlockHit2:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		elseif RNG == 3 then
			local Sound = SFX.Combat.BlockHit3:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		else
			local Sound = SFX.Combat.BlockHit4:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		end
	else
		local RNG = math.random(1,4)
		if RNG == 1 then
			local Sound = SFX.Combat.Hit1:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		elseif RNG == 2  then
			local Sound = SFX.Combat.Hit2:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		elseif RNG == 3 then
			local Sound = SFX.Combat.Hit3:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		else
			local Sound = SFX.Combat.Hit4:Clone()
			Sound.Parent = Parent
			Debris:AddItem(Sound,Sound.TimeLength)
			Sound:Play()
		end
	end
end


function Utility.DmgHighlight(Data)
	local model= Data.model
	local Dmg = Data.Dmg or nil
	local Vhum, Vroot
	if model and  model:FindFirstChild("Humanoid") and  model:FindFirstChild("HumanoidRootPart") then 
		Vhum, Vroot = model:FindFirstChild("Humanoid"), model:FindFirstChild("HumanoidRootPart")
	end

	local Time = Data.Time or .8


	if Vroot and Vhum and Dmg then 
		task.defer(function()
			Utility.JustDamageIn({Dmg = Dmg, Vroot = Vroot})
		end)
	end


	local highlight = script.Assets['DmgHighlight']:Clone()
	highlight.Parent = model

	-- Image ui
	highlight.FillColor = BrickColor.new('Really red').Color
	local tweenInfo = TweenInfo.new(Time, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local tweenInfo2 = TweenInfo.new(Time/2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(highlight, tweenInfo, {FillTransparency = 1,  OutlineTransparency = 1, })
	tween:Play()
	local tween = TweenService:Create(highlight, tweenInfo2, { FillColor = BrickColor.new('Really red').Color,  OutlineColor = BrickColor.new('Really red').Color })
	tween:Play()

	Debris:AddItem(highlight, Time)





end




function Utility.StunHandler(Character,Task)
	local Humanoid = Character:FindFirstChildWhichIsA('Humanoid')
	if Task == 'Stun' then
		Character:SetAttribute('Stunned',true)
		Humanoid.WalkSpeed = 0
		Humanoid.JumpPower = 0
		Humanoid.AutoRotate = false
		
	elseif Task == 'Unstun' then
		Character:SetAttribute('Stunned',false)
		Humanoid.WalkSpeed = 16
		Humanoid.JumpPower = 50
		Humanoid.AutoRotate = true
	end
end

function Utility.Skillstun(Character,Status)
	local Humanoid = Character:FindFirstChildWhichIsA('Humanoid')
	if Status == 'Using' then
		Character:SetAttribute('Attacking',true)
		
	elseif Status == 'Ended' then
		Character:SetAttribute('Attacking',false)

	end
end

function Utility.CharacterMass(Character,Task)
	for _,v in pairs(Character:GetDescendants()) do
		if v:IsA('BasePart') then
			if Task == "Massless" then
				v.Massless = true
			elseif Task == "Mass" then
				v.Massless = false
			end
		end
	end
end

function Utility.Emit(Data)
	local Attachment = Data.Attachment or error("No attachment given. Is this n**** serious")
	local Lifetime = Data.Lifetime or 3
	local Parent = Data.Parent or error("Where's the parent goofball")
	
	local VFX = Attachment:Clone(); VFX.Parent = Parent; Debris:AddItem(VFX,Lifetime)
	
	for _,v in pairs(VFX:GetChildren()) do
		if not v:IsA("ParticleEmitter") then return end
		v:Emit(v:GetAttribute("EmitCount"))
	end
end



function Utility.CreateHitbox(Data)
	local Character = Data.Character or error("Where's the character at cuzzo...")
	local Anchored = Data.Anchored or false
	local Transparency = Data.Transparency or 1
	local cFrame = Data.cFrame or error('No hitbox CFrame! Are you serious right neow bro?')
	local Size = Data.Size or Vector3.new(5.899, 6, 6.051)
	
	local Hitbox = Instance.new("Part")
	
	Hitbox.Massless = true
	Hitbox.BrickColor = BrickColor.new("Really red")
	Hitbox.CanCollide = false
	Hitbox.CanTouch = false
	Hitbox.CanQuery = true
	
	Hitbox.Material = Enum.Material.ForceField
	Hitbox.CFrame = cFrame
	Hitbox.Size = Size
	Hitbox.Transparency = Transparency
	
	Hitbox.CastShadow = false
	Hitbox.Anchored = Anchored
	Hitbox.Parent = workspace.Debris
	
	local hitboxParams = OverlapParams.new() do
		hitboxParams.FilterType = Enum.RaycastFilterType.Exclude 
		hitboxParams.FilterDescendantsInstances = {Character,workspace.Debris,workspace.Map}
	end
	local returnedDictionary = {
		["Hitbox"] = Hitbox;
		["Params"] = hitboxParams
	}
	return returnedDictionary
end
function Utility.NormalHitbox(Data)
	local Character = Data.Character or error("Where's the character at cuzzo...")
	local Anchored = Data.Anchored or false
	local Transparency = Data.Transparency or 1
	local cFrame = Data.cFrame or error('No hitbox CFrame! Are you serious right neow bro?')
	local Size = Data.Size or Vector3.new(5.899, 6, 6.051)
	local Lifetime = Data.Lifetime or .2
	local Guardbreak = Data.Guardbreak or false
	
	local Hitbox = Instance.new("Part") Debris:AddItem(Hitbox,Lifetime)

	Hitbox.Massless = true
	Hitbox.BrickColor = BrickColor.new("Really red")
	Hitbox.CanCollide = false
	Hitbox.CanTouch = false
	Hitbox.CanQuery = true

	Hitbox.Material = Enum.Material.ForceField
	Hitbox.CFrame = cFrame
	Hitbox.Size = Size
	Hitbox.Transparency = Transparency

	Hitbox.CastShadow = false
	Hitbox.Anchored = Anchored
	Hitbox.Parent = workspace.Debris

	--[[local Players,characterTable = game.Players:GetChildren(),{Character}
	for _,v in pairs(Players) do
		local Char = game.Players:GetPlayerFromCharacter(workspace:FindFirstChild(v.Name))
		if Char then
			table.insert(characterTable,v) end
	end]]
	local hitboxParams = OverlapParams.new() do
		hitboxParams.FilterType = Enum.RaycastFilterType.Exclude 
		hitboxParams.FilterDescendantsInstances = {Character,workspace.Debris,workspace.Map}
	end
	
	local Weld = Instance.new("WeldConstraint"); Weld.Part0 = Hitbox; Weld.Part1 = Character.HumanoidRootPart; Weld.Parent = Hitbox
	local Blacklist = {}

	local enemyCaught
	while Hitbox do game["Run Service"].Heartbeat:Wait()
		--local foundParts = workspace:GetPartBoundsInBox(Hitbox.CFrame,Hitbox.Size,hitboxParams)
		local foundParts = workspace:GetPartsInPart(Hitbox,hitboxParams)
		if #foundParts ~= 0 then
			for _,v in pairs(foundParts) do

				local Enemy = v.Parent --potential enemy?!
				local EHum = Enemy:FindFirstChildWhichIsA("Humanoid")
				
				
				
				if EHum and EHum:GetState() ~= Enum.HumanoidStateType.Dead and #Blacklist == 0 then
					table.insert(Blacklist,Enemy)
					local Base = (Character.Head.Position - Enemy.Head.Position).Unit
					local nl = Enemy.Head.CFrame.LookVector
					local dotProduct = Base:Dot(nl)
					
					local EnemyRP = Enemy.HumanoidRootPart
					if Enemy:GetAttribute("Blocking") then
						
						if Guardbreak and dotProduct > .05 then 
							
							Enemy:SetAttribute("Blocking",false)
							Utility.Emit({Attachment = Assets.Effects.Combat.BlockBreak.Attachment,Lifetime = 2.5,Parent = EnemyRP})
							
							Utility.HitSound(EnemyRP,true)
							
							task.defer(function()
								local h = Instance.new('Highlight', Enemy)
								h.FillColor = Color3.fromRGB(255, 0, 4)
								h.DepthMode = "Occluded"
								h.FillTransparency = 0
								h.OutlineTransparency = 1
								game.TweenService:Create(h, TweenInfo.new(.75), {
									FillTransparency = 1;
									OutlineTransparency = 1
								}):Play()
								Debris:AddItem(h ,.75)
								
								local x = math.random(-2,2)
								
								--local DMM = string.sub( tostring(DamageAmount),1,4 )

								local DamageIndicator = RP.Assets.Effects.Combat.GuardbreakGUI:Clone()
								DamageIndicator.CFrame = EnemyRP.CFrame
								DamageIndicator.Parent = workspace.Debris
								--module.Clasic_tween(DamageIndicator.Bill.T1:FindFirstChild('Text'), {Tim = .16*2, EasingStyle = Enum.EasingStyle.Quad, EasingDirection = Enum.EasingDirection.Out,redo = true, Textcolr = BrickColor.new('Really red'), startTextcolr = BrickColor.random().Color })
								TweenService:Create(DamageIndicator,TweenInfo.new(.5,Enum.EasingStyle.Exponential),{CFrame = DamageIndicator.CFrame*CFrame.new(0,1.5,0)}):Play()

								task.delay(.4,function()
									TweenService:Create(DamageIndicator.Guardbreak.Text,TweenInfo.new(.1),{TextTransparency = 1 }):Play()
									TweenService:Create(DamageIndicator.Guardbreak.Text.UIStroke,TweenInfo.new(.1),{Transparency = 1 }):Play()
								end)
								Debris:AddItem(DamageIndicator,.5)

								--[[local Attachment = Instance.new('Attachment') Debris:AddItem(Attachment,.08) 

								local BV = Instance.new('LinearVelocity')
								Debris:AddItem(BV,.08)
								
								Attachment.Parent = DamageIndicator 
								BV.Attachment0 = Attachment
								BV.MaxForce = 30000
								BV.VectorVelocity = Vector3.new(0,25,0)
								BV.Parent = Attachment]]


							end)
							
							Enemy:SetAttribute("Guardbroken",true) task.delay(1,function() Enemy:SetAttribute("Guardbroken",false)  end)
							
							
							
				
							
							
						else
							
							
							if dotProduct > .05 then
								Utility.Emit({Attachment = Assets.Effects.Combat.Block.Attachment,Lifetime = 1,Parent = Enemy.HumanoidRootPart})
								Utility.HitSound(Enemy.HumanoidRootPart,true)
								
								local Anim = Instance.new('Animation')
								Anim.AnimationId = "rbxassetid://87128842350022" --blockhit anim
								local blockHitAnimation = EHum.Animator:LoadAnimation(Anim)
								blockHitAnimation:Play()
								
								local h = Instance.new('Highlight', Enemy)
								h.FillColor = Color3.fromRGB(26, 89, 142)
								h.DepthMode = "Occluded"
								h.FillTransparency = 0
								h.OutlineTransparency = 1
								game.TweenService:Create(h, TweenInfo.new(.5), {
									FillTransparency = 1;
									OutlineTransparency = 1
								}):Play()
								Debris:AddItem(h ,.5)
								
								task.defer(function()
									local x = math.random(-2,2)
									local Rotation = math.random(-5,5)
									--local DMM = string.sub( tostring(DamageAmount),1,4 )

									local DamageIndicator = RP.Assets.Effects.Combat.BlockGUI:Clone()
									DamageIndicator.CFrame = EnemyRP.CFrame; DamageIndicator.Blocked.Text.Rotation = Rotation
									DamageIndicator.CFrame*=CFrame.Angles(math.rad(0),math.rad(0),math.rad(Rotation))
									DamageIndicator.Parent = workspace.Debris

									
									TweenService:Create(DamageIndicator,TweenInfo.new(.5,Enum.EasingStyle.Exponential),{CFrame = DamageIndicator.CFrame*CFrame.new(0,1.5,0)}):Play()
									
									task.delay(.4,function()
										TweenService:Create(DamageIndicator.Blocked.Text,TweenInfo.new(.1),{TextTransparency = 1 }):Play()
										TweenService:Create(DamageIndicator.Blocked.Text.UIStroke,TweenInfo.new(.1),{Transparency = 1 }):Play()
									end)
										
									Debris:AddItem(DamageIndicator,.5)

									
								end)
								
								return
							else
								Enemy:SetAttribute("Blocking",false)
							end
						  end
						end
						
					enemyCaught = Enemy
					break
				end
			end


		end
		break
	end
	return enemyCaught
	
end

function Utility.Pointlight(Data)
	local Point,Range,Brightness,Lifetime = Data.Parent,Data.Range or 10,Data.Brightness or 15,Data.Lifetime or .3
	local Light = script.Assets.PointLight:Clone(); Light.Parent = Point
	
	local Tween = TweenService:Create(Light,TweenInfo.new(.3,Enum.EasingStyle.Sine,Enum.EasingDirection.Out),{Brightness = 0})
	Tween:Play() Tween.Completed:Connect(function()
		Light:Destroy()
	end)
end

function Utility.BlendColors(Color1,Color2)
	local r = (Color1.R + Color2.R)* 127.5 local g = (Color1.G + Color2.G) * 127.5 local b = (Color1.B + Color2.B) * 127.5 
	return Color3.fromRGB(r,g,b) 
end

return Utility
]]></string>
