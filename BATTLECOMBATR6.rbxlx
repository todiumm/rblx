        <string name="Source">local healthDisplay = game.ReplicatedStorage.HealthPercentage
local dummies = workspace:FindFirstChild("Dummies")
if not dummies then return end

for _,v in dummies:GetChildren() do
	local Humanoid = v:FindFirstChildOfClass("Humanoid") 
	if not Humanoid then return end
	if v.Name ~= "Animations" then
		local health = healthDisplay:Clone()
		health.Parent = v.Head
	end
end</string>
