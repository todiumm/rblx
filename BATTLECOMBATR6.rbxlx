            <string name="ScriptGuid">{6A83730C-65CF-4565-BA1D-0D9CD157E479}</string>
            <string name="Source"><![CDATA[
local animKeys = {
	["Blocking"] = "rbxassetid://77422432427663";
}
local Character = script.Parent
local Humanoid = Character.Humanoid
Character:SetAttribute("Blocking",true)

Humanoid.MaxHealth = 500 Humanoid.Health = 500

local Anim = Instance.new('Animation')
Anim.AnimationId = animKeys["Blocking"]
local Animation = Humanoid.Animator:LoadAnimation(Anim)
Animation:Play()


Character:GetAttributeChangedSignal("Blocking"):Connect(function()
	local Attribute = Character:GetAttribute("Blocking")
	if Attribute == false then
		Animation:Stop()
	end
	task.wait(1)
	Animation:Play(); Character:SetAttribute("Blocking",true)
end)]]></string>
