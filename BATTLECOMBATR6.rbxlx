  <Item class="ServerScriptService" referent="4853">
    <Properties>
      <string name="Name">ServerScriptService</string>
      <BinaryString name="AttributesSerialize"></BinaryString>
      <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
      <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
      <bool name="LoadStringEnabled">false</bool>
      <bool name="DefinesCapabilities">false</bool>
      <int64 name="SourceAssetId">-1</int64>
      <BinaryString name="Tags"></BinaryString>
      <UniqueId name="UniqueId">57e745c3f31f372a09c47f770000132e</UniqueId>
    </Properties>
    <Item class="Script" referent="4854">
      <Properties>
        <string name="Name">CombatServer</string>
        <BinaryString name="AttributesSerialize"></BinaryString>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <bool name="Disabled">false</bool>
        <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
        <ContentId name="LinkedSource">
          <null>
          </null>
        </ContentId>
        <token name="RunContext">0</token>
        <bool name="DefinesCapabilities">false</bool>
        <string name="ScriptGuid">{7FAC3541-1664-499C-A456-959AB1A1F1D7}</string>
        <string name="Source">local Players = game.Players

local TS = game:GetService("TweenService")
local RS,Debris = game:GetService("ReplicatedStorage"),game:GetService("Debris")
local Modules = RS.Modules
local Utility,RockModule = require(Modules.Utility),require(Modules.RockModule)

local Assets = RS.Assets
local Remotes = RS.Remotes

local LMBRemote = Remotes.Combat
local stunTime = 2
local DefaultKeys = {
	["M1"] = 0;
	["Stunned"] = false;
	["StunCount"] = 0;
	["Blocking"] = false;
	["BlockingAnimation"] = nil;
	["M1ComboCooldown"] = false;
	["CanDash"] = true;
}
local animKeys = {
--M1 SYSTEM ANIMATIONS
	["1"] = "rbxassetid://97777656034220";
	["2"] = "rbxassetid://86247542123673";
	["3"] = "rbxassetid://104496992322258";
	["4"] = "rbxassetid://97908035994524";
	
	["Downsmash"] = "rbxassetid://105635097142197";
	["Uppercut"] = "rbxassetid://106995394980365";
	["Uppercut2"] = "rbxassetid://106995394980365";

	["WallCombo"] = "rbxassetid://70978605715888";
	
--HURT ANIMATIONS
	["Hurt1"] = "rbxassetid://137569688581681";
	["Hurt2"] = "rbxassetid://100369499670382";
	["Hurt3"] = "rbxassetid://102704880293769";
	["DashHurt"] = "rbxassetid://138209232537017";
	["Knockback"] = "rbxassetid://119708095263039";
	
--BLOCKING SYSTEM ANIMATIONS
	["Blocking"] = "rbxassetid://89641949143333";
	["BlockHit"] = "rbxassetid://82414723395530";
}
local PlayerKeys = {}

local function playAnim(M1Count,Special)
	local Anim = Instance.new('Animation')
	if Special == "Downsmash" then
		Anim.AnimationId = animKeys["Downsmash"]
		
	elseif Special == "Uppercut" then
		Anim.AnimationId = animKeys["Uppercut"]
	
	else
		Anim.AnimationId = animKeys[tostring(M1Count)]
		
	end
	return Anim
end
local function Unstun(Humanoid)
	Humanoid.WalkSpeed = 16
	Humanoid.JumpPower = 50
	Humanoid.JumpHeight = 7.2
end
local function ragdollChar(Enemy)
	task.defer(function()
		local EnemyRP = Enemy.HumanoidRootPart

		if Players:GetPlayerFromCharacter(Enemy) then --if its a player
			
			local ragdollValue = Enemy:WaitForChild("IsRagdoll")
			
			Enemy:SetAttribute('Ragdolled',true)
			
			ragdollValue.Value = true
			task.wait(stunTime)
			ragdollValue.Value = false
			
			Enemy:SetAttribute('Ragdolled',false)
		else --if its not a player
			
			local RagdollModule = require(game.ServerScriptService.NPCRagdollHandler.RagdollBuilder)
			RagdollModule:Setup(Enemy)
			RagdollModule:Ragdoll(Enemy)
			Enemy.Humanoid.Sit = true
			EnemyRP.CFrame = CFrame.new(EnemyRP.Position, Enemy.HumanoidRootPart.Position + Enemy.HumanoidRootPart.CFrame.LookVector.Unit)
			
			task.delay(stunTime,function()
				if not Enemy:FindFirstChild("Humanoid") or not Enemy:FindFirstChild("HumanoidRootPart") then return end
				RagdollModule:Unragdoll(Enemy)
				Enemy.Humanoid.Sit = false

			end)
			
		end
	

	end)
end
local dashStartHP = 0
LMBRemote.OnServerEvent:Connect(function(Player,String,Special,Device) 

	local Character = Player.Character
	local HRP = Character.HumanoidRootPart
	local Humanoid,Animator = Character.Humanoid,Character.Humanoid.Animator
	local PlayerKey = PlayerKeys[Player.UserId]
		
	if String == "M1" then
		if PlayerKey["Blocking"] or PlayerKey["Stunned"] then return end
		local finalM1,Airborne,Uppercut = false,false,false
		
		local M1 = PlayerKey["M1"]

		if PlayerKey["M1ComboCooldown"] then return end
		if M1 == 4 then

			finalM1 = true
			PlayerKey["M1"] = 0

			PlayerKey["M1ComboCooldown"] = true
			task.delay(2.5,function()
				finalM1 = false
				PlayerKey["M1ComboCooldown"] = false end)
			return
		end

		if Special == "Downsmash" then
			Airborne = true
		elseif Special == "Uppercut" then
			Uppercut = true
		end
		PlayerKey["M1"] += 1 
		Character:SetAttribute("M1ing",true)
		Humanoid.JumpHeight = 0
		Humanoid.WalkSpeed = 10

		HRP.Anchored = false

		local newM1 = PlayerKey["M1"]
		task.delay(1.5,function()
			if PlayerKey["M1"] == newM1 then PlayerKey["M1"] = 0 end
		end)


		local Animation
		local Downsmash
		if PlayerKey["M1"] == 4 then
			if Airborne then
				Downsmash = true
				
				Animation = Animator:LoadAnimation(playAnim(nil,"Downsmash"))
				Animation:Play()

			elseif Uppercut then
				Animation = Animator:LoadAnimation(playAnim(nil,"Uppercut"))
				Animation:Play()
				Animation:AdjustSpeed(1.3)
				
			else
				Animation = Animator:LoadAnimation(playAnim(PlayerKey["M1"]))
				Animation:Play()
			end
		else 
			Animation = Animator:LoadAnimation(playAnim(PlayerKey["M1"]))
			Animation:Play()
		end
		Utility.LimbTrail(Character["Right Arm"],.44); Utility.LimbTrail(Character["Left Arm"],.44)
		local Health = Humanoid.Health
		
		Animation:GetMarkerReachedSignal("Hit"):Connect(function()
			if PlayerKey["Stunned"] or Character.Humanoid.Health &lt; Health then return end --to make stuff cancellable 
			Humanoid.WalkSpeed = 10
			Utility.SoundEffect(Assets.SFX.Swing2,HRP)

			local Size,Lifetime
			if Airborne then
				Lifetime = .2
				Size = Vector3.new(6.899,11,6)

			elseif Uppercut then
				Size = Vector3.new(6.899,9,6)

			else 	
				Size = Vector3.new(6.899,7.452,5)
			end
			local Enemy = Utility.NormalHitbox({Character = Character,Anchored = false,Transparency = 1,cFrame = HRP.CFrame+HRP.CFrame.LookVector*4,Size = Size,Lifetime = Lifetime,Guardbreak = Downsmash})
			
			if not Enemy then return end
			local EHum = Enemy.Humanoid
			local EnemyRP = Enemy.HumanoidRootPart
			
			EHum:TakeDamage(4) 
			local HP = EHum.Health
			local potentialPlayer = game.Players:GetPlayerFromCharacter(Enemy)
			
			if potentialPlayer then

				local PlayerKey2 = PlayerKeys[potentialPlayer.UserId]
				PlayerKey2["Stunned"] = true
				PlayerKey2["StunCount"] += 1

				EHum.WalkSpeed = 1; EHum.JumpHeight = 0 EHum.AutoRotate = false
			

				local stunDuration
				if PlayerKey["M1"] == 4 then
					stunDuration = stunTime
				else
					stunDuration = 1
				end
				Enemy:SetAttribute("Stunned",true)
				
				task.delay(stunDuration,function()
					PlayerKey2["StunCount"] -= 1
					
					local stunCount = PlayerKey2["StunCount"]
					if stunCount == 0 then
						Enemy:SetAttribute("Stunned",false)
						EHum.AutoRotate = true
	
						if EHum.Health &lt; HP then return end
						EHum.WalkSpeed = 16; EHum.JumpHeight = 7.2
						PlayerKey2["Stunned"] = false

					end
				end)

			end
			
			
			Utility.HitSound(EnemyRP) 
			local currentString = PlayerKey["M1"]
			if PlayerKey["M1"] == 4 then

				if not Airborne then
					if Uppercut then --uppercut
						Utility.Knockback(EnemyRP,HRP.CFrame.UpVector*40)

						Humanoid.WalkSpeed = 4
						
						
						Remotes.CombatVFX:FireAllClients(Enemy,"Uppercut")
						Utility.SoundEffect(Assets.SFX.DashHit,EnemyRP)

					else --normal hit
						Utility.Emit({Attachment = Assets.Effects.Combat.HitEffect.Attachment,Parent = EnemyRP,Lifetime = 1});
						Utility.Knockback(EnemyRP,HRP.CFrame.LookVector*45)

						--iframes when ragdolled
						local Parent = Enemy.Parent
						Enemy.Parent = workspace.Debris
						task.delay(stunTime+.2,function()
							pcall(function() Enemy.Parent = Parent end)
						end)


					end

					if not potentialPlayer then
						EnemyRP:SetNetworkOwner(Player)
						task.delay(stunTime,function()
							pcall(function()
								EnemyRP:SetNetworkOwner()
							end)
						end)
					end
					
					
				else --downsmash
					
					
					Utility.SoundEffect(Assets.SFX.DamageSFX,Enemy.HumanoidRootPart)
					
					Remotes.CombatVFX:FireAllClients(Enemy,"Downsmash")
					Utility.SoundEffect(Assets.SFX.DashHit,EnemyRP)

					for _,v in Assets.SFX.Downsmash:GetChildren() do
						Utility.SoundEffect(v,EnemyRP)
					end	
					if not Enemy:GetAttribute("Guardbroken") then
						Utility.Emit({Attachment = Assets.Effects.Combat.HitEffect.Downsmash,Parent = EnemyRP,Lifetime = 1.5})
					end
					
					--iframes when ragdolled
					local Parent = Enemy.Parent
					Enemy.Parent = workspace.Debris
					task.delay(stunTime+.2,function()
						pcall(function() Enemy.Parent = Parent end)
					end)

				end

				
				ragdollChar(Enemy)
				
				
			else
				Utility.Emit({Attachment = Assets.Effects.Combat.HitEffect.Attachment,Parent = EnemyRP,Lifetime = 1});
				--Utility.Knockback(EnemyRP,HRP.CFrame.LookVector*1,.5)
				
				if Enemy:GetAttribute("Ragdolled") then

					if game.Players:GetPlayerFromCharacter(workspace:FindFirstChild(Enemy)) then --if its a player

						local RagdollModule = require(game.ServerScriptService.ragdollM)
						RagdollModule.DRDoll(Enemy)

					else --if its not a player

						local RagdollModule = require(game.ServerScriptService.NPCRagdollHandler.RagdollBuilder)
						RagdollModule:Unragdoll(Enemy)

				
					end

					Enemy.Humanoid.Sit = false
				else
					--[[local LV = HRP.CFrame.LookVector*7
					Utility.Knockback(EnemyRP,LV)
					Utility.Knockback(HRP,LV)]]
					
					local Anim = Instance.new('Animation')
					Anim.AnimationId = animKeys["Hurt1"]
					if PlayerKey["M1"] == 1 then
						Anim.AnimationId = animKeys["Hurt1"]
					elseif PlayerKey["M1"] == 2 then
						Anim.AnimationId = animKeys["Hurt2"]
					elseif PlayerKey["M1"] == 3 then
						Anim.AnimationId = animKeys["Hurt3"]
					end
					local Animation = EHum.Animator:LoadAnimation(Anim)
					Animation:Play()
				end
			end
		end)

		Animation.Stopped:Connect(function()
			if Device == "Mobile" then
				task.wait(.25)
			else
				task.wait(.15)
			end
			if PlayerKey["M1"] &gt; newM1 or PlayerKey["Stunned"] then return end
			Character:SetAttribute("M1ing",false)
			Humanoid.WalkSpeed = 16
			Humanoid.JumpHeight = 7.2
		end)
		
	elseif String == "Blocking" then
		local Toggle = Special  --this will return true or false (see the combat client local script)
		
		if Toggle == true and not PlayerKey["Blocking"] then
			if PlayerKey["Stunned"] or PlayerKey["StunCount"] &gt; 0 then return end
			if Character:GetAttribute("M1ing") then return end
			
			HRP.Anchored = false
			Character:SetAttribute("CanDash",false)
			PlayerKey["Blocking"] = true; Character:SetAttribute("Blocking",true)
			Humanoid.WalkSpeed = 4
			
			local Anim = Instance.new('Animation')
			Anim.AnimationId = animKeys["Blocking"]
			local Animation = Humanoid.Animator:LoadAnimation(Anim)
			Animation:Play()
			
			PlayerKey["BlockingAnimation"] = Animation
			
			Character:GetAttributeChangedSignal("Blocking"):Connect(function()
				local Attribute = Character:GetAttribute("Blocking")
				if Attribute == false then
					PlayerKey["Blocking"] = false
					Character:SetAttribute("CanDash",true)
					
					
					if PlayerKey["StunCount"] == 0 then
						PlayerKey["Stunned"] = false
					end

					local Animation = PlayerKey["BlockingAnimation"]
					if Animation then
						Animation:Stop()
					end
				end
				
			end)
			
		elseif Toggle == false then
			Character:SetAttribute("Blocking",false)
			
			if PlayerKey["StunCount"] &gt; 0 then return end
		
			Humanoid.WalkSpeed = 16
			
			--ragdollChar(Character)
		end
	
	elseif String == "Front" or String == "Left" or String == "Right" or String == "Backward" then
		if PlayerKey.StunCount &gt; 0 then return end
		Character:SetAttribute("CanDash",false)
		HRP.Anchored = false
		if String == "Front" then
			dashStartHP = Humanoid.Health
			PlayerKey["Stunned"] = true
			PlayerKey["StunCount"] += 1

			Humanoid.WalkSpeed = 0


		else
			task.delay(1,function()
				Character:SetAttribute("CanDash",true)
			end)
		end

		Utility.SoundEffect(Assets.SFX.Dash,HRP)
		
	elseif String == "WallCombo" then
		local rayPosition,Enemy = Special,Device
		local EnemyRP,EHum = Enemy.HumanoidRootPart,Enemy.Humanoid

		
		
		Character:SetAttribute("CanDash",false) Character:SetAttribute("LockOff",true) --for mobile players xd
		PlayerKey["Stunned"] = true PlayerKey["StunCount"] = 1

		if Enemy:GetAttribute("Ragdolled") then

			if game.Players:GetPlayerFromCharacter(Enemy) then --if its a player

				local RagdollModule = require(game.ServerScriptService.ragdollM)
				RagdollModule.DRDoll(Enemy)

				Enemy.Parent = workspace
			else --if its not a player

				local RagdollModule = require(game.ServerScriptService.NPCRagdollHandler.RagdollBuilder)
				RagdollModule:Unragdoll(Enemy)

				Enemy.Parent = workspace.Dummies or workspace
			end

		end
		Remotes.WallCutscene:FireClient(Player)
		
		local potentialPlayer = game.Players:GetPlayerFromCharacter(Enemy)
		if potentialPlayer then

			
			local PlayerKey2 = PlayerKeys[potentialPlayer.UserId]
			PlayerKey2["Stunned"] = true
			PlayerKey2["StunCount"] = 1

			EHum.WalkSpeed = 1; EHum.JumpHeight = 0 

			task.delay(3.5,function()
				PlayerKey2["StunCount"] = 0
				
				EHum.AutoRotate = true

				EHum.WalkSpeed = 16; EHum.JumpHeight = 7.2
				PlayerKey2["Stunned"] = false

			end)

		end

		EnemyRP.Anchored = true
		EHum.AutoRotate = false

		HRP.Anchored = true 
		Humanoid.AutoRotate = false

		HRP.CFrame*=CFrame.Angles(math.rad(0),math.rad(-90),math.rad(0))
		HRP:PivotTo(CFrame.lookAt(rayPosition + (HRP.CFrame.RightVector*5),rayPosition))

		EnemyRP.CFrame*=CFrame.Angles(math.rad(0),math.rad(-90),math.rad(0))
		TS:Create(EnemyRP,TweenInfo.new(.22),{CFrame = EnemyRP:PivotTo(CFrame.lookAt(HRP.Position + (HRP.CFrame.LookVector*3),HRP.Position))}):Play()

		local Anim = Instance.new('Animation')
		Anim.AnimationId = animKeys["DashHurt"]
		local HurtAnimation = EHum.Animator:LoadAnimation(Anim)
		HurtAnimation:Play()

		local ComboAnim = Instance.new('Animation')
		ComboAnim.AnimationId = animKeys.WallCombo
		local Animation = Humanoid.Animator:LoadAnimation(ComboAnim)
		Animation:Play()

		local Parent1,Parent2 = Character.Parent,Enemy.Parent
		Character.Parent = workspace.Debris; Enemy.Parent = workspace.Debris --this is to give them iframes

		Remotes.CombatVFX:FireAllClients(Character,"WallCombo")

		local sfx
		local start = true
		Animation:GetMarkerReachedSignal("Hit"):Connect(function()
			if start then
				sfx = Utility.SoundEffect(Assets.SFX.Barrage,HRP)
			end
			start = false
			if EHum:GetState() == Enum.HumanoidStateType.Dead then Animation:Stop() return end

			local Anim = Instance.new('Animation')
			Anim.AnimationId = animKeys["Hurt1"]
			if math.random(1,3) == 1 then
				Anim.AnimationId = animKeys["Hurt1"]
			elseif math.random(1,3) == 2 then
				Anim.AnimationId = animKeys["Hurt2"]
			else
				Anim.AnimationId = animKeys["Hurt3"]
			end
			local Animation = EHum.Animator:LoadAnimation(Anim)
			Animation:Play()

			Utility.SoundEffect(Assets.SFX.Swing2,HRP)

			if EHum.Health &gt; 2 then
				EHum:TakeDamage(2)
			end
			Utility.Emit({Attachment = Assets.Effects.Combat.HitEffect.Attachment,Parent = EnemyRP,Lifetime = 1});
			Utility.HitSound(EnemyRP)
		end)

		Animation:GetMarkerReachedSignal("Finish"):Connect(function()
			sfx:Destroy()
			Utility.SoundEffect(Assets.SFX.Swing,HRP); Utility.SoundEffect(Assets.SFX.DashHit,EnemyRP); Utility.SoundEffect(Assets.SFX.Danger,EnemyRP)

			Utility.SoundEffect(Assets.SFX.BigImpact,HRP); Utility.SoundEffect(Assets.SFX.DamageSFX,HRP); Utility.SoundEffect(Assets.SFX.EchoHit,EnemyRP)

			EnemyRP.Anchored = false; EHum.AutoRotate = true
			ragdollChar(Enemy)
			Utility.Knockback(EnemyRP,HRP.CFrame.RightVector*20 + HRP.CFrame.UpVector*20)
			Utility.Emit({Attachment = Assets.Effects.Combat.HitEffect.Attachment,Parent = EnemyRP,Lifetime = 1});

			if not (game.Players:GetPlayerFromCharacter(Enemy)) then
				EnemyRP:SetNetworkOwner(Player)
				task.delay(.7,function()
					EnemyRP:SetNetworkOwner()
				end)
			end

			if EHum.Health &lt;= 2 then
				task.wait(.1)
			end	
			EHum:TakeDamage(2)
		end)

		Animation.Stopped:Connect(function()
			Character:SetAttribute("LockOff",false)
			Character.Parent = Parent1; Enemy.Parent = Parent2	
			HRP.Anchored = false; Humanoid.AutoRotate = true

			task.wait(.3)
			PlayerKey.StunCount = 0
			
			Character:SetAttribute("CanDash",true)
			Character:SetAttribute("M1ing",false)
			PlayerKey.Stunned = false
			Unstun(Humanoid)
	
		end)


	elseif String == "FrontDash" then
		
		if dashStartHP &gt; Humanoid.Health then
			task.delay(1,function()
				PlayerKey["StunCount"] -= 1

				if PlayerKey["StunCount"] == 0 then
					Character:SetAttribute("CanDash",true)
					Character:SetAttribute("M1ing",false)
					PlayerKey["Stunned"] = false
					Unstun(Humanoid)

				end
			end)
			return
		end--if the character took damage within the window of them using the dash and the hitbox event firing
		local Enemy = Utility.NormalHitbox({Character = Character,Anchored = false,Transparency = 1,cFrame = HRP.CFrame+HRP.CFrame.LookVector*2.5,Size = Vector3.new(6.899,7.452,7),Lifetime = .25})
		Utility.SoundEffect(Assets.SFX.Swing2,HRP)

		if not Enemy then 
			task.delay(.2,function()
				PlayerKey["StunCount"] -= 1
	
				if PlayerKey["StunCount"] == 0 then
					Character:SetAttribute("CanDash",true)
					Character:SetAttribute("M1ing",false)
					PlayerKey["Stunned"] = false
					Unstun(Humanoid)

				end
			end)
			return
		else
				
			PlayerKey["StunCount"] -= 1
		
			if PlayerKey["StunCount"] == 0 then
			
				Character:SetAttribute("M1ing",false)
				Character:SetAttribute("CanDash",true)
				PlayerKey["Stunned"] = false
				task.delay(.1,function()
					Unstun(Humanoid)
				end)
				
			end

		end

		local EHum = Enemy.Humanoid
		local EnemyRP = Enemy.HumanoidRootPart
	
		
		EHum:TakeDamage(5) 
		
		local HP = EHum.Health
		local potentialPlayer = game.Players:GetPlayerFromCharacter(Enemy)

		Enemy:SetAttribute("Stunned",true)
		if potentialPlayer then

			local PlayerKey2 = PlayerKeys[potentialPlayer.UserId]
			PlayerKey2["Stunned"] = true
			PlayerKey2["StunCount"] += 1

			EHum.WalkSpeed = 1; EHum.JumpHeight = 0 --EHum.AutoRotate = false

			task.delay(stunTime,function()
				
				PlayerKey2["StunCount"] -= 1
				
				local stunCount = PlayerKey2["StunCount"] 
				if stunCount == 0 then
					Enemy:SetAttribute("Stunned",false)
					EHum.AutoRotate = true
	
					if EHum.Health &lt; HP then return end
					EHum.WalkSpeed = 16; EHum.JumpHeight = 7.2
					PlayerKey2["Stunned"] = false

				end
			end)

		end


		EnemyRP:PivotTo(CFrame.lookAt(HRP.Position + (HRP.CFrame.LookVector*3),HRP.Position))
		if Enemy:GetAttribute("Ragdolled") then


			if potentialPlayer then --if its a player

				local ragdollValue = Enemy:WaitForChild("IsRagdoll")

				Enemy:SetAttribute('Ragdolled',false)

				ragdollValue.Value = false

			else --if its not a player

				local RagdollModule = require(game.ServerScriptService.NPCRagdollHandler.RagdollBuilder)
				RagdollModule:Unragdoll(Enemy)


			end

			Enemy.Humanoid.Sit = false
			EnemyRP.Anchored = false
			
			
			local Anim = Instance.new('Animation')
			Anim.AnimationId = animKeys["Knockback"]
			local Animation = EHum.Animator:LoadAnimation(Anim)
			Animation:Play()
	
			Remotes.CombatVFX:FireAllClients(Enemy,"Knockback")

			if not potentialPlayer then
				EnemyRP:SetNetworkOwner(Player)
				task.delay(.7,function()
					EnemyRP:SetNetworkOwner()
				end)
			end

			Utility.Knockback(EnemyRP,HRP.CFrame.LookVector*85,.5)

		
			local Ring = Assets.Effects.Combat.DashShockwave:Clone() Debris:AddItem(Ring,.3)
			Ring.CFrame = HRP.CFrame*CFrame.new(0,0,-2); Ring.CFrame*=CFrame.Angles(math.rad(90),math.rad(0),math.rad(0)); Ring.Parent = workspace.Debris

			TS:Create(Ring,TweenInfo.new(.35,Enum.EasingStyle.Exponential),{Size = Vector3.new(8,.75,8);Transparency = 1;CFrame = Ring.CFrame*CFrame.new(0,0,-1)}):Play()
			
			Utility.SoundEffect(Assets.SFX.EchoingHit,EnemyRP); Utility.SoundEffect(Assets.SFX.HeavyHit,EnemyRP)
			
		else
			Utility.Emit({Attachment = Assets.Effects.Combat.HitEffect.Attachment3,Parent = EnemyRP,Lifetime = 1.5})
			
			local Anim = Instance.new('Animation')
			Anim.AnimationId = animKeys["DashHurt"]
			local Animation = EHum.Animator:LoadAnimation(Anim)
			Animation:Play()
		end

		
		
		
		Utility.SoundEffect(Assets.SFX.DashHit,EnemyRP); Utility.SoundEffect(Assets.SFX.Danger,EnemyRP)
		
	end
	
end)

Players.PlayerAdded:Connect(function(Player)
	PlayerKeys[Player.UserId] = table.clone(DefaultKeys) 
end)</string>
