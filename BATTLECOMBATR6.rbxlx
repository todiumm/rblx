          <string name="Source"><![CDATA[local Players = game:GetService("Players").LocalPlayer
local Character = Players.Character
local Debris = game.Debris
local UIS,TS = game:GetService("UserInputService"),game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Debounce = false
local RockModule,Utility = require(game.ReplicatedStorage.Modules.RockModule),require(game.ReplicatedStorage.Modules.Utility)


local Cooldown = 1.5
local dashMod = require(game.StarterPlayer.StarterPlayerScripts.Dash)
UIS.InputBegan:Connect(function(Input,GPE)
	if GPE or Debounce or Character:GetAttribute("Stunned") or Character:GetAttribute("CanDash") == false then return end
	if Character:GetAttribute("Ragdolled") then return end
	
	if Input.KeyCode == Enum.KeyCode.Q then
		
		

		local movementKeys = {
			["A"] = false;
			["D"] = false;
		};

		for key, bool in pairs(movementKeys) do
			if UIS:IsKeyDown(Enum.KeyCode[key]) then
				movementKeys[key] = true
			end
		end

		local Direction
		if movementKeys["A"] == true then
			Direction = "Left"
		elseif movementKeys["D"] == true then
			Direction = "Right"
		else
			return
		end
		Debounce = true
		task.delay(Cooldown,function() 
			Debounce = false
		end)

		game.ReplicatedStorage.Remotes.Combat:FireServer(Direction)

		local dashAnim = game.ReplicatedStorage.Assets.Animations:FindFirstChild(Direction.. "Dash")
		local animSubstance = Character.Humanoid:LoadAnimation(dashAnim)
		
		animSubstance:Play()
		
		dashMod.sideDash({Anim = animSubstance,Char = Character,Dir = Direction})
		
	end
end)

]]></string>
          <int64 name="SourceAssetId">-1</int64>
          <BinaryString name="Tags"></BinaryString>
          <UniqueId name="UniqueId">31f5793c9777c8fb0a5d74d6000049cd</UniqueId>
