          <string name="ScriptGuid">{90d7cdb9-2e97-43bd-8146-6b5ef9ec4448}</string>
          <string name="Source">--|| Services ||--
local rp = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

--|| Utility ||--
local UtilityModule = require(rp.Assets.Modules.Utility)

local functions_ = {["Data"] = {}}
function functions_:ClearAllData()
	functions_.Data = {}
end

function functions_:ClearData(Model : Model | Part | UnionOperation | MeshPart)
	functions_.Data[Model] = {}
end

function functions_:AddData(Model : Model | Part | UnionOperation | MeshPart)
	functions_.Data[Model] = UtilityModule:deepSearchFolder(Model, "ParticleEmitter")
	return
end

function functions_:GetData(Model : Model | Part | UnionOperation | MeshPart)
	local stock = {}
	for _, particle in pairs(functions_.Data[Model]) do
		table.insert(stock, particle)
	end

	return stock
end

function functions_:CheckData(Model : Model | Part | UnionOperation | MeshPart)
	local stock = functions_.Data[Model] or nil
	if not stock then functions_:AddData(Model); return functions_:GetData(Model) end
	return stock
end

function functions_:Emit(Model : Model | Part | UnionOperation | MeshPart)
	local particlesData = functions_:CheckData(Model)
	for i = 1, #particlesData do
		particlesData[i]:Emit(particlesData[i]:GetAttribute("EmitCount"))
	end

	return
end

function functions_:SetEnable(Model : Model | Part | UnionOperation | MeshPart)
	local particlesData = functions_:CheckData(Model)
	for i = 1, #particlesData do
		particlesData[i].Enabled = true
	end

	return
end

function functions_:SmoothDestroy(Model : Model | Part | UnionOperation | MeshPart, CountDelay : number?)
	local particlesData = functions_:CheckData(Model)
	local MaxLifeTime = CountDelay or functions_:GetMaxLifeTime(Model)

	for i = 1, #particlesData do
		particlesData[i].Enabled = false
	end

	task.delay(MaxLifeTime, function() 
		Debris:AddItem(Model, .005)
	end)
end

function functions_:GetMaxLifeTime(Model : Model | Part | UnionOperation | MeshPart)
	local particlesData = functions_:CheckData(Model)
	local max = 0
	for i = 1, #particlesData do
		if particlesData[i].Lifetime.Max &gt; max then
			max = particlesData[i].Lifetime.Max
		end
	end
	return max
end

return functions_</string>
