    <Item class="LocalScript" referent="4508">
      <Properties>
        <string name="Name">CombatClient</string>
        <BinaryString name="AttributesSerialize"></BinaryString>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <bool name="Disabled">false</bool>
        <UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
        <ContentId name="LinkedSource">
          <null>
          </null>
        </ContentId>
        <token name="RunContext">0</token>
        <bool name="DefinesCapabilities">false</bool>
        <string name="ScriptGuid">{EF23F486-8579-4E48-9CCC-75C6C7958D79}</string>
        <string name="Source"><![CDATA[local RP = game:GetService("ReplicatedStorage")
local remotes = RP:WaitForChild("Remotes")

local LMBRemote = remotes:WaitForChild("Combat")

local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

task.wait(1)
local Player = script.Parent.Parent 
local Character = Player.Character
local Humanoid = Character:WaitForChild("Humanoid")

local Debounce,blockDebounce = false,false
local Blocking = false

local Mouse = Player:GetMouse()
local mouseDown = false
Mouse.Button1Down:Connect(function()
	mouseDown = true
end)

Mouse.Button1Up:Connect(function()
	mouseDown = false
end)


local Utility = require(game.ReplicatedStorage.Modules.Utility)

--local PlayerGUI = game.Players.LocalPlayer.PlayerGui

local function Block(Input,GPE)
	if GPE or Debounce or Humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	if Character:GetAttribute("Stunned") then return end
	if Input.KeyCode == Enum.KeyCode.F then
		if blockDebounce or Blocking then return end

		Blocking = true
		blockDebounce = true

		LMBRemote:FireServer("Blocking",true)
	end
end
local function M1()
	if Humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	if Character:GetAttribute("Stunned") or Character:GetAttribute("Blocking") then return end
	if mouseDown and not Debounce then

		Debounce = true; task.delay(.4,function()
			Debounce = false
		end)
		local Special
		if Humanoid.FloorMaterial == Enum.Material.Air and not UIS:IsKeyDown(Enum.KeyCode.Space) then
			Special = "Downsmash"

		elseif UIS:IsKeyDown(Enum.KeyCode.Space) and Humanoid.FloorMaterial ~= Enum.Material.Air  then
			Special = "Uppercut"
		end
		LMBRemote:FireServer("M1",Special)


	end
end


local function Unblock(Input,GPE)
	if GPE or Humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	if not Blocking then return end
	if Input.KeyCode == Enum.KeyCode.F then

		Blocking = false
		task.delay(.55,function()
			blockDebounce = false
		end)
		LMBRemote:FireServer("Blocking",false)

	end
end
UIS.InputBegan:Connect(Block)

UIS.InputEnded:Connect(Unblock)

if UIS.TouchEnabled then return end
RunService.Heartbeat:Connect(M1)


]]></string>
