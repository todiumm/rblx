          <string name="Source">local Players = game:GetService("Players").LocalPlayer
local Character = Players.Character
local Debris = game.Debris

local CAS = game:GetService("ContextActionService")

local UIS,TS = game:GetService("UserInputService"),game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")

local Debounce = false
local RockModule,Utility = require(game.ReplicatedStorage.Modules.RockModule),require(game.ReplicatedStorage.Modules.Utility)

local Cooldown = 1.5
local dashMod = require(game.StarterPlayer.StarterPlayerScripts.Dash)
local function Dash()
	if Debounce or Character:GetAttribute("Stunned") or Character:GetAttribute("CanDash") == false then return end

	local Humanoid = Character.Humanoid
	local HRP = Character.HumanoidRootPart
	

	local Direction 	
	local moveDirection = Humanoid.MoveDirection
	
	task.spawn(function()
		local forwardVector = Character.HumanoidRootPart.CFrame.LookVector
		local rightVector =	Character.HumanoidRootPart.CFrame.RightVector

		local forwardDotProduct = moveDirection:Dot(forwardVector)
		local rightDotProduct = moveDirection:Dot(rightVector)

		if math.abs(forwardDotProduct) &lt; math.abs(rightDotProduct) then
			if rightDotProduct &gt; 0 then
				-- Dash right
				Direction = "Right"
			else
				-- Dash left
				Direction = "Left"
			end
		end

	end)
	if not Direction then return end
	Debounce = true
	task.delay(Cooldown,function() 
		Debounce = false
	end)
	game.ReplicatedStorage.Remotes.Combat:FireServer(Direction)
	
	local dashAnim = game.ReplicatedStorage.Assets.Animations:FindFirstChild(Direction.. "Dash")
	local animSubstance = Character.Humanoid:LoadAnimation(dashAnim)

	animSubstance:Play()

	dashMod.sideDash({Anim = animSubstance,Char = Character,Dir = Direction})

end

local PlayerGUI = game.Players.LocalPlayer.PlayerGui
if UIS.TouchEnabled then
	local Buttons = PlayerGUI:WaitForChild("MobileGUI")
	Buttons.Enabled = true

	local dashButton = Buttons.Dash

	dashButton.TextButton.MouseButton1Down:Connect(Dash)

end</string>
