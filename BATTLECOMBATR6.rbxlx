              <string name="ScriptGuid">{4732FAA6-44EE-404B-9CB6-67F96FED8DBE}</string>
              <string name="Source">local Part = script.Parent

local function Caculate()
	local MainVec = Part.AssemblyLinearVelocity
	local dir = Part.Position-MainVec
	local unit = (MainVec).Unit
	local size = (Part.Position - (Part.Position-MainVec)).Magnitude
	local NewPart = Instance.new("Part")
	NewPart.CanCollide = false
	if size &gt; 1 then
		if size &lt; 5 then
			size = 5
		else
			if size &gt; 10 then
				size = 10
			end
		end
		NewPart.Massless = true
		NewPart.CFrame = Part.CFrame
		NewPart.CFrame = CFrame.lookAt(NewPart.Position,dir)
		NewPart.CFrame = NewPart.CFrame * CFrame.new(0,0,size/2)
		NewPart.Size = Vector3.new(0.25,0.25,size)
		NewPart.Color = Color3.new(0.333333, 1, 0)
		NewPart.Anchored = true
		NewPart.Material = Enum.Material.Neon
		NewPart.Transparency = 0.7
		NewPart.Parent = workspace.Debris
		game.Debris:AddItem(NewPart,0.05)
	else
		NewPart:Destroy()
	end
end

game:GetService("RunService").Stepped:Connect(Caculate)</string>
