        <string name="ScriptGuid">{D56A8F27-D654-47D3-891B-E6883B611795}</string>
        <string name="Source"><![CDATA[local RP = game:GetService("ReplicatedStorage")
local remotes = RP:WaitForChild("Remotes")

local LMBRemote = remotes:WaitForChild("Combat")

local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")


local Player = script.Parent.Parent 
local Character = Player.Character
local Humanoid = Character:WaitForChild("Humanoid")

local Debounce,blockDebounce = false,false
local Blocking = false

local lmbDown,Jumping = false,false


local PlayerGUI = game.Players.LocalPlayer.PlayerGui


local function Block()
	if Debounce or Humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	if Character:GetAttribute("Stunned") then return end

	if blockDebounce or Blocking then return end

	Blocking = true
	blockDebounce = true

	LMBRemote:FireServer("Blocking",true)

end
local function M1()
	if Humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	if Character:GetAttribute("Stunned") then return end
	if not Debounce then
		
		Debounce = true; task.delay(.4,function()
			Debounce = false
		end)
		local Special
		if Humanoid.FloorMaterial == Enum.Material.Air and not Jumping then
			Special = "Downsmash"

		elseif Jumping and Humanoid.FloorMaterial ~= Enum.Material.Air  then
			Special = "Uppercut"
		end
		LMBRemote:FireServer("M1",Special,"Mobile")


	end
end


local function Unblock()
	if Humanoid:GetState() == Enum.HumanoidStateType.Dead then return end
	if not Blocking then return end

	Blocking = false
	task.delay(.55,function()
		blockDebounce = false
	end)
	LMBRemote:FireServer("Blocking",false)


end

if UIS.TouchEnabled then
	local Buttons = PlayerGUI:WaitForChild("MobileGUI")
	Buttons.Enabled = true
	
	
	local LMB = Buttons.Combat
	local BlockUI = Buttons.Block	

	LMB.ImageButton.MouseButton1Down:Connect(M1)

	BlockUI.ImageButton.MouseButton1Down:Connect(Block)

	BlockUI.ImageButton.MouseButton1Up:Connect(Unblock)

	local jumpButton = PlayerGUI:WaitForChild("TouchGui")["TouchControlFrame"]:WaitForChild("JumpButton")
	jumpButton.MouseButton1Down:Connect(function()
		Jumping = true
	end)
	jumpButton.MouseButton1Up:Connect(function()
		Jumping = false
	end)
	
	task.delay(1,function()
		PlayerGUI:WaitForChild("LockOn").Enabled = true
	end)
end
]]></string>
