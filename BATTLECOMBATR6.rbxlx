            <string name="Source">local RP,TS,Debris = game.ReplicatedStorage,game.TweenService,game.Debris
local Assets = RP.Assets
local RockModule,Utility = require(RP.Modules.RockModule),require(RP.Modules.Utility)

RP.Remotes.CombatVFX.OnClientEvent:Connect(function(Character,String)
	local HRP = Character.HumanoidRootPart

	if String == "Uppercut" then
		local Ring = Assets.Effects.Combat.DashShockwave:Clone() Debris:AddItem(Ring,1)
		Ring.CFrame = HRP.CFrame*CFrame.new(0,2,0); Ring.CFrame*=CFrame.Angles(math.rad(0),math.rad(90),math.rad(0)); 
		Ring.Size = Vector3.new(.25,8,.25)
		--Ring.CFrame = HRP.CFrame*CFrame.new(0,5,0); Ring.CFrame*=CFrame.Angles(math.rad(0),math.rad(90),math.rad(0)); 
		--old ring cframe as seen in the video

		--TS:Create(Ring,TweenInfo.new(.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out,1,false,0),{Size = Vector3.new(8,.6,8);Transparency = 1;CFrame = Ring.CFrame*CFrame.new(0,-4,0)}):Play()
		--above is the old tweening as seen in the video 

		TS:Create(Ring,TweenInfo.new(.3,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Size = Vector3.new(9,.3,9);Transparency = 1;CFrame = Ring.CFrame*CFrame.new(0,2,0)}):Play()
		Ring.Parent = workspace.Debris

		Utility.LimbTrail(HRP,1.3)



	elseif String == "Downsmash" then

		local Ring = game.ReplicatedStorage.Assets.Effects.Combat.DashShockwave:Clone() Debris:AddItem(Ring,.35)
		Ring.Size = Vector3.new(0.25, 5, 0.25)
		Ring.CFrame = HRP.CFrame*CFrame.new(0,5,0); Ring.CFrame*=CFrame.Angles(math.rad(0),math.rad(90),math.rad(0)); Ring.Parent = workspace.Debris

		TS:Create(Ring,TweenInfo.new(.25,Enum.EasingStyle.Quart),{Size = Vector3.new(16,1,16);Transparency = 1;CFrame = Ring.CFrame*CFrame.new(0,-5.5,0)}):Play()

		local groundCrack = Assets.Effects.Combat.GroundSmash:Clone(); groundCrack.Parent = workspace.Debris game.Debris:AddItem(groundCrack,4.5)
		local VFX = groundCrack.Attachment
		groundCrack.Position = HRP.Position+Vector3.new(0,-3,0)

		TS:Create(groundCrack.Decal1,TweenInfo.new(4.5),{Transparency = 1}):Play()

		for _,v in pairs(VFX:GetChildren()) do
			if not v:IsA("ParticleEmitter") then return end

			local Params = RaycastParams.new(); Params.FilterType = Enum.RaycastFilterType.Include
			Params.FilterDescendantsInstances = {workspace.Map}
			local rayCast = workspace:Raycast(HRP.Position,HRP.CFrame.UpVector*-10,Params)
			if rayCast then
				if rayCast.Instance then
					local Color = rayCast.Instance.Color
					v.Color = ColorSequence.new(Color)
					v:Emit(v:GetAttribute("EmitCount"))
				end
			else
				groundCrack.Decal1.Transparency = 1
				v:Emit(v:GetAttribute("EmitCount"))
			end

		end

		RockModule.FlyRock(HRP.Position,Vector3.new(0,-8,0),.2,2,1,20,10,100,1,7)
		RockModule.Crater(HRP.Position,Vector3.new(0,-8,0),6,5,-5,3.85,5,6,75,0.4,3,3)
		RockModule.Crater(HRP.Position,Vector3.new(0,-8,0),4,9,-5,6,5,6,65,0.4,3,3)


	elseif String == "Knockback" then

		local Clock,Duration = os.clock(),.6
		Utility.LimbTrail(HRP,1)

		task.defer(function()
			repeat task.wait(.065)
				RockModule.SideRock2(HRP.CFrame,HRP.CFrame.UpVector*-5,2,.75,1)
			until (os.clock() - Clock) &gt; Duration 
		end)

		local dashPart = game.ReplicatedStorage.Assets.Effects.Combat.DashLines:Clone()
		dashPart.Parent = workspace.Debris
		dashPart.CFrame = HRP.CFrame * CFrame.new(0, -4, 0)

		dashPart.CFrame = HRP.CFrame * CFrame.new(0, -4, 0) * CFrame.Angles(0,math.rad(180),0)
		for _,v in dashPart:GetChildren() do
			v.Enabled = false
			v.Rate = 0 
			v.Lifetime = NumberRange.new(0,0)
		end

		local weld = Instance.new('WeldConstraint', dashPart)
		weld.Part0 = dashPart
		weld.Part1 = HRP



		repeat
			task.wait(.075)


			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = {workspace.Map}

			for _, particle in pairs(dashPart:GetDescendants()) do
				if particle:IsA("ParticleEmitter") then
					particle:Emit(2)
				end
			end

			local smokePart = game.ReplicatedStorage.Assets.Effects.Combat.SmokePart:Clone()
			smokePart.Parent = workspace.Debris
			smokePart.CFrame = HRP.CFrame * CFrame.new(0,-1.5,0)

			local raycast = workspace:Raycast(smokePart.Position, Vector3.new(0, -2.5, 0) , params)
			if raycast then
				smokePart.Position = raycast.Position

				for _, particle in pairs(smokePart:GetDescendants()) do
					if particle:IsA("ParticleEmitter") then
						particle.Color = ColorSequence.new(raycast.Instance.Color)
						particle:Emit()
					end
				end
				game.Debris:AddItem(smokePart,2)
			else
				smokePart:Destroy()
			end

		until (os.clock() - Clock) &gt; Duration


		dashPart:Destroy()

	elseif String == "WallCombo" then
		Utility.LimbTrail(Character["Right Arm"],2);Utility.LimbTrail(Character["Left Arm"],2);Utility.LimbTrail(Character["Left Leg"],2);Utility.LimbTrail(Character["Right Leg"],2)
		local Barrage = game.ReplicatedStorage.Assets.Effects.Combat.WallCombo.ComboVFX:Clone()
		local sparkle = Barrage.Front.eyeSparkle
		sparkle.Parent = Character.Head Debris:AddItem(sparkle,1)

		for _, particle in pairs(sparkle:GetDescendants()) do
			if particle:IsA("ParticleEmitter") then
				particle:Emit(particle:GetAttribute('EmitCount'))
			end
		end

		--[[task.delay(.4,function()
			for i = 1,7 do task.wait(.2)
				local x = math.random(-2,2) local Rotation = math.random(-5,5)

				local Die = game.ReplicatedStorage.Assets.Effects.Combat.WallCombo.DIEText:Clone()
				Die.CFrame = HRP.CFrame; Die.TextUI.Text.Rotation = Rotation
				Die.CFrame*=CFrame.Angles(math.rad(0),math.rad(0),math.rad(Rotation))
				Die.Parent = workspace.Debris

				TS:Create(Die,TweenInfo.new(.2,Enum.EasingStyle.Exponential),{CFrame = Die.CFrame*CFrame.new(0,1.5,0)}):Play()

				task.delay(.15,function()
					TS:Create(Die.TextUI.Text,TweenInfo.new(.35),{TextTransparency = 1}):Play()
					TS:Create(Die.TextUI.Text.UIStroke,TweenInfo.new(.35),{Transparency = 1}):Play()
				end)
				Debris:AddItem(Die,.5)
			end


		end)]] 

		task.delay(.4,function()
			
			Debris:AddItem(Barrage,3)
			Barrage:PivotTo((HRP.CFrame+HRP.CFrame.LookVector*3+HRP.CFrame.UpVector*1.5)*CFrame.Angles(math.rad(-90),math.rad(0),math.rad(0)))
			Barrage.Parent = workspace.Debris

			
			local rayParams = RaycastParams.new(); rayParams.FilterType = Enum.RaycastFilterType.Include
			rayParams.FilterDescendantsInstances = {workspace.Map}
			local raycast = workspace:Raycast(HRP.CFrame.Position, Vector3.new(0, -10, 0) , rayParams)
			if raycast then
				local Color = ColorSequence.new(raycast.Instance.Color)
				for _, particle in pairs(Barrage.VFX.Attachment3:GetDescendants()) do
					if particle:IsA("ParticleEmitter") then
						particle.Color = Color
					end
				end
				Barrage.VFX.Smoke.Color = Color
				Barrage.UnderSmoke.SM1.Color = Color; Barrage.UnderSmoke.SM2.Color = Color; Barrage.UnderSmoke.SM3.Color = Color
			end

			task.wait(1.3)
			for _,v in Barrage:GetDescendants() do
				if v:IsA("ParticleEmitter") then
					v.Enabled = false
				end
			end
			task.wait(.2)
			raycast = workspace:Raycast(HRP.CFrame.Position,HRP.CFrame.LookVector*10,rayParams)
			if raycast then
				local inst = raycast.Instance
			end
		end)
	end
end)</string>
