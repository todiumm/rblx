          <string name="Source">-- this is a mold shape this with events and calls to make the ragdoll fit for your use

local char = script.Parent
local hum = char:WaitForChild("Humanoid")
local RGed = char:WaitForChild("RGed")

local function change_state()
	if RGed.Value then 
		hum:ChangeState(Enum.HumanoidStateType.Physics) -- sleepy time
	else
		hum:ChangeState(Enum.HumanoidStateType.GettingUp) -- awaken
	end
end



RGed.Changed:Connect(change_state)</string>
